# Copy to .env for local development without Docker. Never commit real credentials.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://tracking:tracking@localhost:5432/tracking
DATABASE_POOL_SIZE=10
RUN_MIGRATIONS_ON_START=true

WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=20
WORKER_LEASE_MS=30000

WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_MS=1000
WEBHOOK_BACKOFF_MAX_MS=300000
# Only for local demos: allows http:// webhook URLs (production requires https).
WEBHOOK_ALLOW_HTTP=false
